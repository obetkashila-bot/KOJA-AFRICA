# KOJA AFRICA production environment variables
# Set these in Render Dashboard > Environment, not in source control.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_STORAGE_BUCKET=koja-files
SITE_URL=https://koja-africa.onrender.com
SECRET_KEY=GENERATE_A_LONG_RANDOM_SECRET
GSC_SITE_URL=https://koja-africa.onrender.com
# Optional: JSON service-account credentials for the Admin Google Search Console tools.
GSC_SERVICE_ACCOUNT_JSON=
# Optional AI research summary endpoint
AI_API_KEY=
OPENAI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
