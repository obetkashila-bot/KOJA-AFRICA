# KOJA AFRICA production environment template
# NEVER commit real values to GitHub.

SITE_URL=https://koja-africa.onrender.com
SECRET_KEY=GENERATE_A_LONG_RANDOM_PRODUCTION_SECRET

# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Payments
FLW_SECRET_KEY=YOUR_FLUTTERWAVE_LIVE_SECRET
FLW_PUBLIC_KEY=YOUR_FLUTTERWAVE_LIVE_PUBLIC_KEY

# LiveKit
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET

# KOJA Cloud
KOJA_CLOUD_API_URL=https://YOUR-KOJA-CLOUD/api/v1
KOJA_CLOUD_API_KEY=YOUR_KOJA_CLOUD_API_KEY

# Email: choose one production provider
RESEND_API_KEY=
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# SMS: configure after provider onboarding
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# FX: configure one trusted provider
FX_API_URL=
EXCHANGE_RATE_API_KEY=

# OAuth production credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
