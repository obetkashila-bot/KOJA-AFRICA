# Keyless FCM relay: Render does NOT store a Firebase service-account private key.
FCM_RELAY_URL=https://YOUR_REGION-YOUR_PROJECT.cloudfunctions.net/sendKojaPush
FCM_RELAY_SECRET=YOUR_LONG_RANDOM_RELAY_SECRET
